# Copy to .env and fill in real values. .env is git-ignored.
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Optional: SMTP server (defaults to the Mailpit service of compose.yaml)
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@tasks.local
# EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
# PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Optional: media storage. STORAGE_DRIVER is rustfs (default, the compose.yaml service) or aws-s3.
# STORAGE_DRIVER=rustfs
# S3_BUCKET=tasks-media
# rustfs driver:
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=
# S3_ACCESS_KEY=tasks-dev
# S3_SECRET_KEY=tasks-dev-secret
# S3_CREATE_BUCKET=true
# aws-s3 driver (credentials from the AWS default chain: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, IAM role, ...):
# AWS_REGION=eu-west-3

# Optional: antivirus (ClamAV service of compose.yaml, about 1 GB of RAM).
# ANTIVIRUS_ENABLED=false stores uploads unscanned, for machines that cannot run ClamAV.
# ANTIVIRUS_ENABLED=true
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Optional: RabbitMQ (rabbitmq service of compose.yaml, management UI on http://localhost:15672).
# Outside development, point the application at the broker with SPRING_RABBITMQ_HOST, SPRING_RABBITMQ_USERNAME
# and SPRING_RABBITMQ_PASSWORD.
# RABBITMQ_USERNAME=tasks
# RABBITMQ_PASSWORD=tasks-dev
# RABBITMQ_PORT=5672

# Base64-encoded HMAC key, at least 32 bytes once decoded: openssl rand -base64 32
JWT_SECRET=

# Copy to .env and fill in real values. .env is git-ignored.
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Optional: SMTP server (defaults to the Mailpit service of compose.yaml)
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@tasks.local
# EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# Base64-encoded HMAC key, at least 32 bytes once decoded: openssl rand -base64 32
JWT_SECRET=

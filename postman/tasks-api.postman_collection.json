    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task (admin, assigned to user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks"
              ]
            },
            "description": "ADMIN: can set `assignedTo` on creation. `priority`: LOW | MEDIUM | HIGH | URGENT (default MEDIUM). The reference must be unique (409 otherwise), hence `{{$timestamp}}`. Stores `taskId` for the following requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"TASK-{{$timestamp}}\",\n  \"title\": \"My first task\",\n  \"description\": \"Created from Postman\",\n  \"priority\": \"HIGH\",\n  \"dueAt\": \"2026-12-31T18:00:00Z\",\n  \"assignedTo\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [201]', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "if (pm.response.code === 201) { const t = pm.response.json(); pm.collectionVariables.set('taskId', t.id); pm.collectionVariables.set('taskReference', t.reference); }"
                ]
              }
            }
          ]
        },

                "{{taskId}}",
                "status"
              ]
            },
            "description": "ADMIN or the assigned user. `status`: TO_DO | IN_PROGRESS | IN_REVIEW | BLOCKED | DONE | ARCHIVED | CANCELLED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
